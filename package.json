{
  "name": "aluminum-frame-helper",
  "version": "1.0.0",
  "description": "本地铝合金切框助手",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "build:desktop": "electron-builder --win --mac",
    "package": "vite build && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.example.aluminumframe",
    "productName": "铝合金算料助手",
    "directories": {
      "output": "dist_desktop"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "mammoth": "^1.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  }
}
